import json
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

headers = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
}

print("📊 QUERYING GLOBAL OPEN-ACCESS REPOSITORIES FOR SOLID-STATE ELECTROLYTE LITERATURE...\n")

counts = {}

# 1. OpenAlex Global Index (Largest Open-Access Database Worldwide)
try:
    url = "https://api.openalex.org/works?filter=is_oa:true,default.search:solid%20state%20electrolyte"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode('utf-8'))
    counts['OpenAlex (Global Open Access Index)'] = data.get('meta', {}).get('count', 0)
except Exception as e:
    counts['OpenAlex (Global Open Access Index)'] = f"Error: {e}"

# 2. Europe PMC / PubMed Central (Full-Text Peer-Reviewed Open-Access Papers with PDFs)
try:
    url = "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=%22solid%20state%20electrolyte%22%20OPEN_ACCESS:y%20HAS_PDF:y&format=json"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode('utf-8'))
    counts['Europe PMC (Peer-Reviewed Full PDFs)'] = data.get('hitCount', 0)
except Exception as e:
    counts['Europe PMC (Peer-Reviewed Full PDFs)'] = f"Error: {e}"

# 3. arXiv Materials Science & Physics Repository
try:
    url = "http://export.arxiv.org/api/query?search_query=cat:cond-mat.mtrl-sci+AND+all:%22solid+state+electrolyte%22&start=0&max_results=1"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as resp:
        xml_data = resp.read()
    root = ET.fromstring(xml_data)
    ns = {'opensearch': 'http://a9.com/-/spec/opensearch/1.1/'}
    total_elem = root.find('opensearch:totalResults', ns)
    counts['arXiv (Preprints & Materials Science)'] = int(total_elem.text) if total_elem is not None else 0
except Exception as e:
    counts['arXiv (Preprints & Materials Science)'] = f"Error: {e}"

# 4. Semantic Scholar Open Access API
try:
    url = "https://api.semanticscholar.org/graph/v1/paper/search?query=solid+state+electrolyte&isOpenAccess=true&limit=1"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode('utf-8'))
    counts['Semantic Scholar (Open Access)'] = data.get('total', 0)
except Exception as e:
    counts['Semantic Scholar (Open Access)'] = f"Error: {e}"

# ==============================================================================
# DISPLAY CENSUS RESULTS
# ==============================================================================
print("==========================================================================")
print("     GLOBAL TOTAL OPEN-ACCESS SOLID-STATE ELECTROLYTE RESEARCH PAPERS     ")
print("==========================================================================\n")

for source, count in counts.items():
    if isinstance(count, int):
        print(f"  • {source:<45}: {count:,} papers")
    else:
        print(f"  • {source:<45}: {count}")

print("\n--------------------------------------------------------------------------")
if isinstance(counts.get('OpenAlex (Global Open Access Index)'), int):
    total_oa = counts['OpenAlex (Global Open Access Index)']
    print(f"🌐 ESTIMATED TOTAL UNIQUE OPEN-ACCESS PAPERS WORLDWIDE: ~{total_oa:,} PAPERS")
print("==========================================================================")
     
