import os
import re
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
import shutil
from google.colab import files

download_dir = "./bulk_sse_papers_large"
os.makedirs(download_dir, exist_ok=True)

# Flexible materials science query terms
KEYWORDS = [
    "solid state electrolyte",
    "lithium battery electrolyte",
    "ionic conductivity electrolyte",
    "garnet LLZO",
    "sulfide electrolyte",
    "NASICON LATP",
    "halide electrolyte",
    "polymer electrolyte LiTFSI"
]
TARGET_TOTAL = 100  # Total target papers to download

headers = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
}

print(f"🚀 STARTING BULK DOWNLOAD OF {TARGET_TOTAL}+ SOLID-STATE ELECTROLYTE PAPERS...\n")

total_downloaded = 0
seen_titles = set()

for keyword in KEYWORDS:
    if total_downloaded >= TARGET_TOTAL:
        break

    print(f"=======================================================")
    print(f"🔍 Searching arXiv Materials Science for: '{keyword}'...")
    print(f"=======================================================")

    # Properly encode ALL search parameters using urllib.parse.urlencode
    params = {
        'search_query': f'cat:cond-mat.mtrl-sci AND all:{keyword}',
        'start': 0,
        'max_results': 30,
        'sortBy': 'submittedDate',
        'sortOrder': 'descending'
    }
    url = f"http://export.arxiv.org/api/query?{urllib.parse.urlencode(params)}"

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req) as resp:
            xml_data = resp.read()
             root = ET.fromstring(xml_data)
        ns = {'atom': 'http://www.w3.org/2005/Atom'}
        entries = root.findall('atom:entry', ns)

        print(f"Found {len(entries)} matching papers on arXiv.")

        for entry in entries:
            if total_downloaded >= TARGET_TOTAL:
                break

            title_elem = entry.find('atom:title', ns)
            title = title_elem.text.strip().replace('\n', ' ') if title_elem is not None else "Paper"

            # Avoid duplicate papers
            clean_title_key = re.sub(r'\W+', '', title.lower())
            if clean_title_key in seen_titles:
                continue
            seen_titles.add(clean_title_key)

            # Find direct PDF link
            pdf_url = None
            for link in entry.findall('atom:link', ns):
                if link.attrib.get('title') == 'pdf' or link.attrib.get('type') == 'application/pdf':
                    pdf_url = link.attrib.get('href')
                    break

            if not pdf_url:
                id_text = entry.find('atom:id', ns).text
                arxiv_id = id_text.split('/abs/')[-1]
                pdf_url = f"https://arxiv.org/pdf/{arxiv_id}.pdf"
 Create safe filename
            filename = re.sub(r'[\/*?:"<>|]', '', title).replace(' ', '_').strip()
            filename = filename.encode('ascii', errors='ignore').decode('ascii')[:80] + ".pdf"
            save_path = os.path.join(download_dir, filename)

            if os.path.exists(save_path):
                total_downloaded += 1
                continue

            try:
                pdf_req = urllib.request.Request(pdf_url, headers=headers)
                with urllib.request.urlopen(pdf_req, timeout=15) as p_resp:
                    content = p_resp.read()

                # VERIFY BINARY HEADER (%PDF-)
                if content.startswith(b'%PDF-'):
                    with open(save_path, 'wb') as f_out:
                        f_out.write(content)

                    total_downloaded += 1
                    size_mb = len(content) / (1024 * 1024)
                    print(f"  ✓ [{total_downloaded}/{TARGET_TOTAL}] Saved ({size_mb:.2f} MB): {filename[:55]}...")
                else:
                    print(f"  ⚠️ Skipped non-PDF stream for {filename[:30]}")

                time.sleep(1.0) # respectful delay to prevent rate limit

            except Exception as e:
                print(f"  ⚠️ Download error for {filename[:30]}: {e}")

    except Exception as e:
        print(f"  ❌ Query failed for '{keyword}': {e}")
        print(f"\n=======================================================")
print(f"🎉 SUCCESS! Total Verified PDF Research Papers Downloaded: {total_downloaded}")
print(f"=======================================================\n")

# Zip all 100+ PDF files into a single zip archive
zip_filename = "bulk_sse_research_papers_100plus"
print(f"📦 Compressing {total_downloaded} PDFs into '{zip_filename}.zip' (please wait 1 minute)...")
shutil.make_archive(zip_filename, "zip", download_dir)

# Download the zip file directly to your computer
print("📥 Starting direct download to your computer...")
files.download(f"{zip_filename}.zip")
